<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's V8 needs JIT and unsigned executable memory under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound TLS to the DeepSQL VM and outbound SSH for the tunnel transport. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The SSH tunnel binds a loopback listener the renderer connects back to. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Reading a user-selected OpenSSH private key (.pem) from disk. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
  </dict>
</plist>
